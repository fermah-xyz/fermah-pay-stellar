  "query": "\n        SELECT w.id, w.amount, w.destination_address, w.state\n        FROM pay_stellar.withdrawals w\n        JOIN pay_stellar.buyers b ON b.id = w.buyer_id\n        WHERE w.seller_deployment_id = $1 AND b.wallet_address = $2 AND w.withdrawal_id = $3\n        ",
