  "query": "\n        SELECT c.id, c.amount, c.state, c.outcome\n        FROM pay_stellar.charges c\n        JOIN pay_stellar.buyers b ON b.id = c.buyer_id\n        WHERE c.seller_deployment_id = $1 AND b.wallet_address = $2 AND c.charge_id = $3\n        ",
