  "query": "\n            SELECT b.id, b.available, b.vault_synced_ledger, w.amount\n            FROM pay_stellar.withdrawals w\n            JOIN pay_stellar.buyers b ON b.id = w.buyer_id\n            WHERE w.id = $1 AND w.seller_deployment_id = $2 AND w.network = $3\n            FOR UPDATE OF b\n            ",
