{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT d.id, d.amount, d.state\n        FROM pay_stellar.deposits d\n        JOIN pay_stellar.buyers b ON b.id = d.buyer_id\n        WHERE d.seller_deployment_id = $1 AND b.wallet_address = $2 AND d.deposit_id = $3\n        ",
